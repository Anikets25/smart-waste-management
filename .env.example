# ─────────────────────────────────────────────────────────────
#  Smart Waste Management System — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Flask secret key — change this to a long random string in production
SECRET_KEY=your-very-secret-key-change-this

# MySQL database connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_waste_db
DB_USER=root
DB_PASSWORD=your_mysql_password

# Max allowed upload size in bytes (default: 5 MB)
MAX_CONTENT_LENGTH=5242880

# Folder where uploaded images are stored
UPLOAD_FOLDER=static/uploads

# Set to True only when running over HTTPS (production)
SESSION_COOKIE_SECURE=False
